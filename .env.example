AI_PROVIDER=openai
# Optional common model overrides. If blank, the selected provider's model defaults below are used.
AI_ORCHESTRATOR_MODEL=
AI_COMPOSER_MODEL=

OPENAI_API_KEY=
OPENAI_ORCHESTRATOR_MODEL=gpt-6-luna
OPENAI_COMPOSER_MODEL=gpt-5-nano

OPENROUTER_API_KEY=
OPENROUTER_ORCHESTRATOR_MODEL=openai/gpt-6-luna
OPENROUTER_COMPOSER_MODEL=openai/gpt-5-nano

ANTHROPIC_API_KEY=
ANTHROPIC_ORCHESTRATOR_MODEL=claude-sonnet-4-5
ANTHROPIC_COMPOSER_MODEL=claude-haiku-4-5

# AI_PROVIDER=claude-subscription uses your Claude subscription through the
# locally installed, logged-in Claude Code CLI. No API key is needed.
CLAUDE_SUBSCRIPTION_ORCHESTRATOR_MODEL=sonnet
CLAUDE_SUBSCRIPTION_COMPOSER_MODEL=haiku
CLAUDE_BIN=

SONGS_DIR=
PORT=3001
RUN_TIMEOUT_MS=180000
